# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string.
# If mongodb+srv:// fails with "querySrv ECONNREFUSED", your DNS resolver
# refuses SRV lookups — use the non-SRV form from Atlas
# (Connect -> Drivers -> "Node.js 2.2.12 or later").
MONGODB_URI=mongodb://user:password@host1:27017,host2:27017/bloomwell?ssl=true&authSource=admin

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Where new orders are sent on WhatsApp. Digits only, with country code.
ADMIN_WHATSAPP_NUMBER=919876543210

# ---------------------------------------------------------------- image storage
# Where new product images go: "cloudinary" or "local".
# Unset means Cloudinary if it's configured, else local disk.
#
# Vercel MUST use cloudinary — its filesystem is read-only outside /tmp, and
# /tmp is wiped between invocations. Use "local" only on a VPS or any host with
# a persistent disk, where files are served from public/uploads.
#
# The setting only affects NEW uploads. Every image records which provider
# holds it, so switching later never breaks pictures already live.
STORAGE_DRIVER=cloudinary

# From the Cloudinary dashboard: "API Environment variable".
# Format: cloudinary://<api-key>:<api-secret>@<cloud-name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@your-cloud-name
